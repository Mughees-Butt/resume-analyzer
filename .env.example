# ─────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# Database (PostgreSQL)
# Locally: set by docker-compose
# Production: set by Railway
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# ─────────────────────────────────────────
# Redis
# Locally: set by docker-compose
# Production: set by Railway
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# Clerk (Auth) — Phase 6
# ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─────────────────────────────────────────
# Cloudflare R2 (File Storage)
# ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resume-analyzer-files

# ─────────────────────────────────────────
# App URLs
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
